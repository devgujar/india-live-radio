{
  // Cloudflare Workers config for serving the built SPA as static assets.
  // Docs: https://developers.cloudflare.com/workers/static-assets/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "india-live-radio",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    // Serve index.html for unknown routes so client-side routing works.
    "not_found_handling": "single-page-application"
  }
}
